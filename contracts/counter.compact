pragma language_version >= 0.14.0;

import CompactStandardLibrary;

export ledger counter: Uint<32>;
export ledger secret_hash: Bytes<32>;

witness secret_password(): Bytes<32>;

export circuit increment(): [] {
    assert(persistentHash(secret_password()) == secret_hash, "Incorrect password");
    counter = counter + 1;
}

constructor(initial_hash: Bytes<32>) {
    secret_hash = initial_hash;
    counter = 0;
}
